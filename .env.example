# Copia este archivo como .env para desarrollo local y completa los valores.
# En producción (Netlify) estas variables ya están configuradas en el sitio,
# no es necesario un archivo .env allí.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: subida directa de imágenes a Cloudflare R2 vía Worker.
# Si no se define, la app usa la Edge Function 'generate-r2-url' de Supabase.
VITE_WORKER_URL=
VITE_CLOUDFLARE_IMAGE_DELIVERY=
